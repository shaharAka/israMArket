{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "i18n:extract": "node scripts/extract-messages.mjs",
    "i18n:sync": "python3 ../scripts/sync-translations.py",
    "i18n:check": "node scripts/check-translations.mjs && node scripts/test-translation-format.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "html-to-image": "^1.11.13",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
