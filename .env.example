# Gemini — strategy (3.8 Flash), reading the business's site (3.8 Flash: brand, site
# profile, the landing preview's sample post), cheap checks (3.5 Flash Lite), each
# business's Design DNA (3.8 Flash), image fallback (Nano Banana 2)
GEMINI_API_KEY=
GEMINI_EXTRACT_MODEL=gemini-3.8-flash
DESIGN_DNA_MODEL=gemini-3.8-flash
# Build the Design DNA in the background after a site scan and at signup.
DESIGN_DNA_ON_SCAN=true

# Images (docs/image-models.md, docs/design-dna.md "Model routing"): Muse Image makes new
# images and edits of the owner's real photos ($0.01 each, uses META_MODEL_API_KEY).
# When Muse refuses (e.g. lingerie generation), errors or times out, IMAGE_FALLBACK_MODEL
# takes over. "gemini" skips Muse for that task. Never a `-contributor` Meta model.
IMAGE_GENERATE_PROVIDER=muse
IMAGE_EDIT_PROVIDER=muse
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_IMAGE_TIMEOUT_SECONDS=45
IMAGE_FALLBACK_MODEL=gemini-3.1-flash-image
# The Gemini model when a provider is "gemini": Nano Banana 2 at 1K ($0.068) matched Pro in
# the bench at half the price. gemini-3-pro-image (2K) stays as an explicit "best" option.
# gemini-2.5-flash-image is retired (read as Nano Banana 2).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K

# One headless-Chrome screenshot of the site during a brand scan (the best colour
# signal). Skipped silently when no Chrome is found. Chrome's traffic goes through a
# local SSRF-checking proxy. In a container: install chromium, set CHROME_PATH, and
# CHROME_NO_SANDBOX=true when the user has no namespaces.
SITE_SCREENSHOT=true
CHROME_PATH=
CHROME_NO_SANDBOX=false

# Prefer the business's OWN photos scraped from their site over a generated one.
# Generation remains the fallback when no usable photo is found.
REAL_PHOTO_FIRST=true

# Auth — BOTH are required in production.
# JWT_SECRET signs sessions. TOKEN_ENCRYPTION_KEY encrypts stored GA4/Meta OAuth
# tokens; if it is omitted the key is derived from JWT_SECRET, which is refused while
# JWT_SECRET is still the shipped default.
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=
# development | production. Production refuses to boot with the default JWT_SECRET.
ENVIRONMENT=development

# Session cookie. Leave blank to derive from WEB_ORIGIN's scheme (https => Secure).
COOKIE_SECURE=

# Frontend origin (CORS + OAuth redirects + CSRF origin check)
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
# The origin printed on every WhatsApp tracked link: {PUBLIC_BASE_URL}/r/{code}. Blank =
# WEB_ORIGIN (the web tier forwards /r/{code} to the API). Changing it later breaks links
# already posted, so pick the final domain before owners start posting.
PUBLIC_BASE_URL=
# Counted taps per link per minute (the redirect keeps working past it, uncounted).
WHATSAPP_CLICKS_PER_MINUTE=30

# Rate limiting for /auth/login and /auth/register: N requests per window.
AUTH_RATE_LIMIT=8
AUTH_RATE_WINDOW_SECONDS=300
# Trust X-Forwarded-For when identifying clients. Correct behind the Next.js proxy;
# set false if this API is ever reachable directly, or clients can spoof it.
TRUST_FORWARDED_FOR=true

# Google OAuth client: "להמשיך עם Google" sign-in (openid email profile) and the
# Analytics + Search Console connection share it. Console steps: deploy/gcp/google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base of every Google redirect URI. Blank = WEB_ORIGIN + /backend, i.e.
# {WEB_ORIGIN}/backend/auth/google/callback and {WEB_ORIGIN}/backend/integrations/ga4/callback
# OAUTH_REDIRECT_BASE=

# Meta Graph API (Facebook / Instagram)
META_APP_ID=
META_APP_SECRET=
# Graph API version for every Meta call (default v25.0, supported until July 2028).
# META_GRAPH_VERSION=v25.0
# Hashtag Search for the inspiration brief. Needs Meta's "Instagram Public Content
# Access" feature (app review); capped at 30 unique hashtags per 7 days per IG account.
# INSTAGRAM_HASHTAG_SEARCH=false

# PayPal subscription billing (docs/billing.md). Blank = /billing says payment is not
# open yet, and nothing is enforced. sandbox = api-m.sandbox.paypal.com, live = api-m.paypal.com.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `cd api && python -m app.jobs.paypal_setup` (not secret).
PAYPAL_PLAN_ID=
# developer.paypal.com > the app > Webhooks: the id of https://<host>/backend/billing/paypal/webhook
PAYPAL_WEBHOOK_ID=
# true = after the free month + 3 days with nothing paid, AI generation answers 402.
BILLING_ENFORCE=false

# The owner's backoffice at /admin (DEPLOY.md, "Backoffice"). Not secret.
# Comma-separated, case-insensitive. Empty = nobody is an admin.
ADMIN_EMAILS=
# true (keep it): an admin must also be signed in with "להמשיך עם Google" (the account is
# linked to Google and this session came from Google), so Google's 2-step verification
# guards every account. Password signup does not verify the address: with false, whoever
# registers an admin address first is an admin. Only for local development.
ADMIN_REQUIRE_GOOGLE=true

# Optional: bind the API.
# NOTE: 0.0.0.0 exposes the API to your network. Keep 127.0.0.1 unless you have put
# authentication in front of it — /docs and /openapi.json are public by default.
API_HOST=127.0.0.1
API_PORT=8000

# Experiment (Stream H): Meta Model API / Muse Spark as an alternative post writer.
# Off by default. Never use a *-contributor model (refused in code): their inputs are
# used to improve Meta's products. See api/scripts/README-model-compare.md.
META_MODEL_API_KEY=
POST_MODEL=gemini
META_POST_MODEL=muse-spark-1.3
POST_MODEL_FALLBACK=true
